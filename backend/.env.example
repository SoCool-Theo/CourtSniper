# Example Configuration - Copy this file to .env and input your actual details

TARGET_URL="https://www.facebook.com/messages/t/YOUR_TARGET_CHAT_ID"
BOOKING_MESSAGE="Message to send for booking the badminton court. Include your details here."

# Target time format for sending the booking message (24-hour format)
TARGET_HOUR=8
TARGET_MINUTE=0
TARGET_SECOND=0

# Kill-switch to arm or disarm (ARMED to send the message, DISARMED to not send the message)
STATUS="ARMED"